generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                String              @id @default(cuid())
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now()) @updatedAt
  name              String?
  email             String?             @unique
  emailVerified     DateTime?
  image             String?
  canvasToken       String?
  agreedDisclaimer  Boolean             @default(false)
  school            School?             @relation("users", fields: [schoolId], references: [id])
  schoolId          String?
  completedCourses  Boolean             @default(false)
  accounts          Account[]
  sessions          Session[]
  Course            Course[]
  SchoolPermissions SchoolPermissions[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CourseClassification {
  id             String  @id @default(cuid())
  name           String  @unique
  classification String
  saved          Boolean @default(true)
}

model School {
  id           String              @id @default(cuid())
  name         String              @unique
  address      String              @unique
  city         String
  state        String
  users        User[]              @relation("users")
  canvasUrl    String
  district     String?
  schedules    Schedule[]
  periods      Period[]
  ScheduleDate ScheduleDate[]
  verified     Boolean             @default(false)
  permissions  SchoolPermissions[]

  @@index([name])
}

model SchoolPermissions {
  id       String @id @default(cuid())
  school   School @relation(fields: [schoolId], references: [id])
  schoolId String
  user     User   @relation(fields: [userId], references: [id])
  userId   String
  role     String

  @@index([schoolId, userId])
}

model Schedule {
  id            String         @id @default(cuid())
  school        School         @relation(fields: [schoolId], references: [id])
  schoolId      String
  name          String
  abbr          String
  periods       PeriodTimes[]
  scheduleDates ScheduleDate[]

  @@index([schoolId])
}

model ScheduleDate {
  id         String   @id @default(cuid())
  schedule   Schedule @relation(fields: [scheduleId], references: [id])
  scheduleId String
  school     School   @relation(fields: [schoolId], references: [id])
  schoolId   String
  date       String

  @@index([scheduleId, schoolId])
}

model Period {
  id        String        @id @default(cuid())
  school    School        @relation(fields: [schoolId], references: [id])
  schoolId  String
  name      String
  groupName String
  groupId   String        @default(cuid())
  times     PeriodTimes[]
  type      String
  order     Int

  @@index([schoolId, groupId])
}

model PeriodTimes {
  id         String   @id @default(cuid())
  schedule   Schedule @relation(fields: [scheduleId], references: [id])
  scheduleId String
  period     Period   @relation(fields: [periodId], references: [id])
  periodId   String
  start      String
  end        String
}

model Course {
  id      String @id @default(cuid())
  user    User   @relation(fields: [userId], references: [id])
  userId  String
  groupId String
  value   String

  @@index([userId])
}
